<?xml version="1.0" encoding="UTF-8"?>
<BundleInfo name="CryoModel" version="0.1.0" package="chimerax.cryomodel" minSessionVersion="1" maxSessionVersion="1">
  <Author name="Matthew L. Baker" />
  <Email>matthew.baker@uth.tmc.edu</Email>
  <URL>https://github.com/mlbaker-uth/CRYOMODEL</URL>
  <Synopsis>Unified cryo-EM modeling toolkit</Synopsis>
  <Description>Unified cryo-EM modeling tools: finders, pathwalker, pyHole.</Description>
