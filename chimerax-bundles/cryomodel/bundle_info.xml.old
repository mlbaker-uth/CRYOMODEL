    <Category name="Volume Data"/>
    <Category name="Structural Analysis"/>
  </Categories>
  <SrcDir>src</SrcDir>
  <Commands>
    <Command name="cryomodel_findligands" synopsis="Assign unmodeled density with CryoModel" />
    <Command name="cryomodel_pdbdomain" synopsis="Domain identification and COM analysis" />
  </Commands>
  <Classifiers>
    <!-- Bundle line is auto-generated; use fix_wheel_metadata.py after build if toolshed rejects -->
